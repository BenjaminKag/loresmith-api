DEBUG=True
SECRET_KEY=dev-secret-key-not-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (Docker passes these, but useful for reference / local runs)
DB_HOST=db
DB_NAME=devdb
DB_USER=devuser
DB_PASS=changeme

# Cache
# Local Docker uses Redis by default.
# AWS/Elastic Beanstalk can use local memory cache to avoid requiring Redis.
CACHE_BACKEND=django_redis.cache.RedisCache
CACHE_LOCATION=redis://redis:6379/1
CACHE_KEY_PREFIX=loresmith_api

# Security settings for production
CSRF_TRUSTED_ORIGINS=https://<elastic-beanstalk-domain>
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# AWS S3 media storage
USE_S3=False
AWS_STORAGE_BUCKET_NAME=changeme
AWS_S3_REGION_NAME=il-central-1
AWS_S3_CUSTOM_DOMAIN=

# --- AI / OpenAI ---
OPENAI_API_KEY=changeme
LORESMITH_AI_ENABLED=false
LORESMITH_AI_MODEL=gpt-4.1-mini
LORESMITH_MAX_OUTPUT_TOKENS=256
LORESMITH_MAX_INPUT_CHARS=8000
LORESMITH_DAILY_TOKEN_BUDGET=50000
